# Which LLM provider to use: gemini | anthropic
LLM_PROVIDER=gemini

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (check AI Studio for current free-tier models)
GEMINI_MODEL=gemini-2.5-flash

# Optional, paid: only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: read a real Gmail mailbox over IMAP (see docs/ADAPTERS.md).
# Uses an App Password, not your account password, and no OAuth scope -
# so none of Google's restricted-scope verification or CASA applies.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
